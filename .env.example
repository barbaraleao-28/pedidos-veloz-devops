# ============================================================================
# LOJA VELOZ - Variáveis de Ambiente (Padrão 12-Factor App)
# Copie este arquivo para .env antes de rodar o ambiente local
# ============================================================================

# Ambiente e Versão
NODE_ENV=development
APP_VERSION=1.2.0
LOG_LEVEL=info

# Portas dos Microsserviços
GATEWAY_PORT=8080
PEDIDOS_PORT=3001
PAGAMENTOS_PORT=3002
ESTOQUE_PORT=3003

# URLs internas (Rede Docker Compose / ClusterIP Kubernetes)
PEDIDOS_SERVICE_URL=http://pedidos-service:3001
PAGAMENTOS_SERVICE_URL=http://pagamentos-service:3002
ESTOQUE_SERVICE_URL=http://estoque-service:3003

# Banco de Dados PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pedidos_veloz
POSTGRES_USER=veloz_admin
POSTGRES_PASSWORD=veloz_dev_secret_2026

# Mensageria / Eventos (Redis Streams)
REDIS_URL=redis://redis:6379

# Observabilidade e Tracing Distribuído (OpenTelemetry / Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAMESPACE=loja-veloz

# Gateway Externo de Pagamentos (Simulado)
PAYMENT_PROVIDER_API_KEY=sk_test_veloz_98f7a6d5c4b3a210
